# Trilha environment template. Names only: never put real values in this file.
# Copy to .env.local for local development. .env.local is ignored by git.
# The app reads these at request time, never at build time. The Notion variables
# are used only by `npm run catalog:import`.

# ---------------------------------------------------------------------------
# Public (exposed to the browser bundle). Only non-secret values belong here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server only (never prefix with NEXT_PUBLIC_, never read in client code).
# Read through lib/env/server.ts, which imports "server-only".
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic API key for briefing analysis, concepts and presentations.
AI_PROVIDER_API_KEY=
# Optional model override. Leave empty to use the tested default.
AI_MODEL=
NOTION_API_KEY=
NOTION_CREATIVE_PATHS_DATABASE_ID=
